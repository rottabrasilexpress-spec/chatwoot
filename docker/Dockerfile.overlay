FROM chatwoot/chatwoot:v4.17.0

# The Rails application and dependencies come from the official image. The
# validated Rotta bundle and the backend rules that power its filters, audit
# trail, and retention policy are overlaid on top of it as well. Keeping these
# files explicit is important: the production image is built from the
# official Chatwoot image and otherwise silently ignores the source-tree
# customizations.
COPY public/vite /app/public/vite
COPY public/brand-assets/rottabrasil-logo.png /app/public/brand-assets/rottabrasil-logo.png
COPY public/brand-assets/rottabrasil-logo-dark.png /app/public/brand-assets/rottabrasil-logo-dark.png
COPY public/brand-assets/rottabrasil-mark.png /app/public/brand-assets/rottabrasil-mark.png
COPY public/brand-assets/rottabrasil-mark-transparent.png /app/public/brand-assets/rottabrasil-mark-transparent.png
COPY public/manifest.json /app/public/manifest.json
COPY config/installation_config.yml /app/config/installation_config.yml
COPY config/schedule.yml /app/config/schedule.yml
COPY config/sidekiq-uazapi.yml /app/config/sidekiq-uazapi.yml
COPY config/routes.rb /app/config/routes.rb
COPY db/migrate/20260820000000_set_rotta_brasil_express_branding.rb /app/db/migrate/20260820000000_set_rotta_brasil_express_branding.rb
COPY db/migrate/20260821000001_archive_existing_rotta_conversations.rb /app/db/migrate/20260821000001_archive_existing_rotta_conversations.rb
