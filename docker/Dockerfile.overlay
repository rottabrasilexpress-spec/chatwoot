FROM chatwoot/chatwoot:v4.17.0

# The Rails application and dependencies come from the official image. The
# validated Rotta bundle and the backend rules that power its filters, audit
# trail, and retention policy are overlaid on top of it as well. Keeping these
# files explicit is important: the production image is built from the
# official Chatwoot image and otherwise silently ignores the source-tree
# customizations.
COPY public/vite /app/public/vite
COPY public/brand-assets/rottabrasil-logo.png /app/public/brand-assets/rottabrasil-logo.png
COPY public/brand-assets/rottabrasil-logo-dark.png /app/public/brand-assets/rottabrasil-logo-dark.png
COPY public/brand-assets/rottabrasil-mark.png /app/public/brand-assets/rottabrasil-mark.png
COPY public/brand-assets/rottabrasil-mark-transparent.png /app/public/brand-assets/rottabrasil-mark-transparent.png
COPY public/manifest.json /app/public/manifest.json
COPY config/installation_config.yml /app/config/installation_config.yml
COPY config/schedule.yml /app/config/schedule.yml
COPY config/sidekiq-uazapi.yml /app/config/sidekiq-uazapi.yml
COPY config/routes.rb /app/config/routes.rb
COPY db/migrate/20260820000000_set_rotta_brasil_express_branding.rb /app/db/migrate/20260820000000_set_rotta_brasil_express_branding.rb
COPY db/migrate/20260821000001_archive_existing_rotta_conversations.rb /app/db/migrate/20260821000001_archive_existing_rotta_conversations.rb
COPY db/migrate/20260821000002_clear_rotta_human_conversation_assignments.rb /app/db/migrate/20260821000002_clear_rotta_human_conversation_assignments.rb
COPY db/migrate/20260822000001_clear_rotta_conversation_teams.rb /app/db/migrate/20260822000001_clear_rotta_conversation_teams.rb
COPY db/migrate/20260908000000_create_message_stars.rb /app/db/migrate/20260908000000_create_message_stars.rb
COPY db/migrate/20260909050000_create_uazapi_webhook_deliveries.rb /app/db/migrate/20260909050000_create_uazapi_webhook_deliveries.rb
COPY app/finders/conversation_finder.rb /app/app/finders/conversation_finder.rb
COPY app/jobs/rotta_archived_conversation_retention_job.rb /app/app/jobs/rotta_archived_conversation_retention_job.rb
COPY app/jobs/rotta_uazapi_contact_avatar_sync_job.rb /app/app/jobs/rotta_uazapi_contact_avatar_sync_job.rb
COPY app/jobs/rotta_uazapi_webhook_delivery_retention_job.rb /app/app/jobs/rotta_uazapi_webhook_delivery_retention_job.rb
COPY app/controllers/api/v1/accounts/rotta_follow_up_controller.rb /app/app/controllers/api/v1/accounts/rotta_follow_up_controller.rb
COPY app/controllers/api/v1/accounts/conversations/messages_controller.rb /app/app/controllers/api/v1/accounts/conversations/messages_controller.rb
COPY app/controllers/webhooks/uazapi_controller.rb /app/app/controllers/webhooks/uazapi_controller.rb
COPY app/services/rotta_uazapi_call_event_service.rb /app/app/services/rotta_uazapi_call_event_service.rb
COPY app/services/messages/send_on_api_service.rb /app/app/services/messages/send_on_api_service.rb
COPY app/services/messages/uazapi_action_service.rb /app/app/services/messages/uazapi_action_service.rb
COPY app/jobs/send_reply_job.rb /app/app/jobs/send_reply_job.rb
COPY app/services/action_service.rb /app/app/services/action_service.rb
COPY app/services/auto_assignment/agent_assignment_service.rb /app/app/services/auto_assignment/agent_assignment_service.rb
COPY app/services/conversations/assignment_service.rb /app/app/services/conversations/assignment_service.rb
COPY app/models/conversation.rb /app/app/models/conversation.rb
COPY app/models/message.rb /app/app/models/message.rb
COPY app/models/message_star.rb /app/app/models/message_star.rb
COPY app/models/uazapi_webhook_delivery.rb /app/app/models/uazapi_webhook_delivery.rb
COPY app/models/account.rb /app/app/models/account.rb
COPY app/models/user.rb /app/app/models/user.rb
COPY app/models/label.rb /app/app/models/label.rb
COPY app/models/concerns/label_activity_message_handler.rb /app/app/models/concerns/label_activity_message_handler.rb
COPY app/views/layouts/vueapp.html.erb /app/app/views/layouts/vueapp.html.erb
COPY app/views/installation/onboarding/index.html.erb /app/app/views/installation/onboarding/index.html.erb
COPY app/views/super_admin/application/_navigation.html.erb /app/app/views/super_admin/application/_navigation.html.erb
COPY app/views/super_admin/devise/sessions/new.html.erb /app/app/views/super_admin/devise/sessions/new.html.erb
